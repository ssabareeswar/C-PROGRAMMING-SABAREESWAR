#include <stdio.h>

int main() {
    long long n;
    if (scanf("%lld", &n) != 1) return 0;

    if (n == 0) {
        printf("0\n");
        return 0;
    }

    while (n > 9) {
        int sum = 0;
        while (n > 0) {
            sum += n % 10;
            n /= 10;
        }
        n = sum; 
    }

    printf("%lld\n", n);
    return 0;
}
