#include <stdio.h>
#include <limits.h>
int main() {
    int N, M;
    if (scanf("%d %d", &N, &M) != 2) return 0;
int matrix[N][M];
for (int i = 0; i < N; i++) {
        for (int j = 0; j < M; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }
    for (int j = 0; j < M; j++) {
        int max_val = INT_MIN; 
for (int i = 0; i < N; i++) {
            if (matrix[i][j] > max_val) {
                max_val = matrix[i][j];
            }
        }
        printf("%d\n", max_val);
    }

    return 0;
}
