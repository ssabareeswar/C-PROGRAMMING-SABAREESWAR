#include <stdio.h>
int main() {
    int n, m, i, j;
    if (scanf("%d %d", &n, &m) != 2) return 0;
int matrix[n][m];
    for (i = 0; i < n; i++) {
        for (j = 0; j < m; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }
    for (i = 0; i < n; i++) {
        int max = matrix[i][0]; 
        for (j = 1; j < m; j++) {
            if (matrix[i][j] > max) {
                max = matrix[i][j];
            }
        }
                printf("%d\n", max);
    }

    return 0;
}
