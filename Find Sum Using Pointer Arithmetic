#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    long long arr[n];
    
    for(int i = 0; i < n; i++) {
        scanf("%lld", &arr[i]);
    }

    long long sum = 0;
    long long *ptr = arr;  

    for(int i = 0; i < n; i++) {
        sum += *(ptr + i); 
    }

    printf("%lld", sum);

    return 0;
}
